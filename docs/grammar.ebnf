(* zuQL v0 core grammar, frozen per docs/07 §1.
   This file describes exactly what crates/zu-query/src/parser.rs accepts.
   Keywords are case-insensitive and are ordinary identifiers to the lexer;
   the parser gives them meaning by position. `<-`, `->` and `=>` are not
   lexer tokens, so `a < -1` lexes as less-than then minus and the parser
   assembles every arrow from single characters. Changes here require a
   spec change to docs/07 first. *)

statement       = statement_block | transaction_statement ;

(* GP18, ISO 13.6. A statement block is the parts of a procedure body,
   and what a session is handed is a procedure body. A part is a query
   or a catalog statement, so a block may hold both, which is the whole
   of the feature: nothing about the syntax says a chain has to be all
   one kind. A catalog statement hands nothing to the part behind it,
   so the parts of a mixed block do not share rows; a run of query
   statements is a linear query and shares them the way it always did.
   The block answers what its last part answered. *)
statement_block = block_part , { "NEXT" , block_part } , [ ";" ] ;
block_part      = query | catalog_statement ;
query           = [ at_schema_clause ] , [ use_clause ] ,
                  { binding_variable_definition } , [ use_clause ] ,
                  composite_query ;
(* The graph clause is written on either side of the definitions and
   once in all, ISO putting it on the statement rather than on the head
   the definitions are. It has to be readable behind them: a clause
   naming a graph a definition above it defined can be written nowhere
   else. *)

(* GT01 and GT02, ISO 15.1 to 15.3. Where a transaction begins and
   ends. These three are not parts of a block: a block runs as one
   transaction, so a word among its parts that began or ended one
   would be saying the unit is two. ISO writes the characteristics as
   a list because it has more of them to come, and the two that mean
   something here are the access modes; a list naming both names
   neither. *)
transaction_statement
                = "START" , "TRANSACTION" ,
                  [ access_mode , { "," , access_mode } ]
                | "COMMIT" | "ROLLBACK" ;
access_mode     = "READ" , ( "ONLY" | "WRITE" ) ;

(* GQ02 to GQ07, ISO 12.1. A composite query meets two result tables.
   Every conjunction is at one level and the fold is to the left, so
   there is no precedence between UNION and INTERSECT the way there is
   in SQL, and a reader who wants one writes the operands in the order
   they should be met. Leaving the set quantifier out means DISTINCT.
   OTHERWISE is not a set operator: it answers the left operand, and
   the right one only when the left had no rows at all. Both operands
   of a conjunction have to have the same columns, and neither may
   write. *)
composite_query = linear_query , { query_conjunction , linear_query } ;
query_conjunction = set_operator , [ "ALL" | "DISTINCT" ] | "OTHERWISE" ;
set_operator    = "UNION" | "EXCEPT" | "INTERSECT" ;

(* GQ20, ISO 12.2. A query is one statement or several chained by NEXT,
   and what a statement hands the one behind it is the result it
   returned and nothing else it had in hand. The rows the caller gets
   are the last statement's. A statement in front of a NEXT ends with
   RETURN unless it writes; a write ends without projecting anything,
   the way it does at the end of a query, and hands on the rows it was
   given. The chain is query statements and nothing else, so a NEXT
   handing over to a catalog statement ends it and the statement block
   above carries on from there. *)
linear_query    = simple_query , { "NEXT" , simple_query } ;
simple_query    = { reading_clause } , return_clause
                | { reading_clause } ;

(* GP16, ISO 16.1. The schema every catalog name written without a path
   in it is resolved in, which today is every procedure name a call
   inside the statement writes. It stands in front of the graph clause
   and reaches the whole statement, so a call that names a schema of
   its own wins: a path says where a thing lives and the clause is only
   the default for a name that gave none. CURRENT_SCHEMA and
   HOME_SCHEMA both name the schema the session opened in, nothing
   moving a session out of one yet.

   Whitespace is nothing to the lexer, so `AT / MATCH (p)` is the same
   tokens as `AT /MATCH (p)` and the path would otherwise swallow the
   word the query begins with. A segment is therefore a name that does
   not open a clause, which makes the root what a clause word straight
   after the slash leaves behind, and a schema really called MATCH is
   written in quotes. *)
at_schema_clause
                = "AT" , ( "CURRENT_SCHEMA" | "HOME_SCHEMA"
                           | [ "SCHEMA" ] , schema_path ) ;

(* GQ01, ISO 16.2. The graph the clauses after it are against. ISO
   writes it as a graph expression, and the four forms here are the
   four that name a graph: the one the session is working in, the one
   it started in, one in the catalog by name, and one the caller passed
   in. A parameter is what makes this a reference rather than a word,
   because which graph it is is settled when the parameter arrives and
   not while the statement is being read. A query with no USE is
   against the graph the session is working in.

   A name here is a graph variable's before it is the catalog's (GP12
   and GP13), a definition being the nearer of the two, so one graph
   variable may be defined as another and a USE may read either. Which
   graph a statement runs against is settled before the statement is
   compiled, the schema of that graph being what the names in it are
   bound against, so a variable a USE reads has to be defined as a
   graph reference; one defined by a query is refused by name. *)
use_clause      = "USE" , graph_ref ;
graph_ref       = "CURRENT_PROPERTY_GRAPH" | "CURRENT_GRAPH"
                  | "HOME_PROPERTY_GRAPH" | "HOME_GRAPH"
                  | [ [ "PROPERTY" ] , "GRAPH" ] , ( graph_name | parameter ) ;

(* GP05 to GP13 and GP17, ISO 13.3. The binding variable definition
   block: names the statements below it may read that no row carries.
   A definition stands for a value, a binding table or a graph, and
   what defines it is either an expression or a whole query in braces.
   Each one is worked out once, before the first row, and in the order
   written, so a definition may read the ones in front of it and not
   itself. It may not read a row, because there is none yet, and it may
   not write, because a statement taken apart at its write runs in
   parts and a definition is worked out once per part. A definition
   whose kind is not BINDING TABLE has to answer one column, and one
   whose kind is VALUE has to answer something that is not a table or a
   graph. The block a CALL body carries is its own: the names go out of
   scope with the block.

   GP06 is the type: a definition may be written with one, and it is
   checked against what the definition answered rather than used to
   shape it. ISO writes the separator in front of it two ways and lets
   the type be written with neither, so all three spellings are one
   definition and the equals is what says the type is over. *)
binding_variable_definition
                = value_variable_definition | table_variable_definition
                | graph_variable_definition ;
typed_as        = "::" | "TYPED" | (* nothing *) ;
value_variable_definition
                = "VALUE" , name , [ typed_as , value_type ] , "=" ,
                  ( [ "VALUE" ] , "{" , query , "}" | expression ) ;
table_variable_definition
                = [ "BINDING" ] , "TABLE" , name , [ typed_as , value_type ] ,
                  "=" , ( "{" , query , "}" | expression ) ;
graph_variable_definition
                = [ "PROPERTY" ] , "GRAPH" , name , [ typed_as , value_type ] ,
                  "=" , ( "{" , query , "}" | graph_ref ) ;

(* Catalog statements (docs/07 §9). They change what the file declares
   and answer no rows, so they are told apart from a query by their
   first two words and never reach the binder. *)

catalog_statement = create_schema | drop_schema | create_graph | drop_graph
                  | create_graph_type | drop_graph_type ;
create_schema   = "CREATE" , "SCHEMA" , [ "IF" , "NOT" , "EXISTS" ] ,
                  schema_path , [ ";" ] ;
drop_schema     = "DROP" , "SCHEMA" , [ "IF" , "EXISTS" ] , schema_path ,
                  [ ";" ] ;
create_graph    = "CREATE" , [ "OR" , "REPLACE" ] , [ "PROPERTY" ] , "GRAPH" ,
                  [ "IF" , "NOT" , "EXISTS" ] , graph_name , graph_type_ref ,
                  [ "AS" , "COPY" , "OF" , graph_ref ] , [ ";" ] ;
drop_graph      = "DROP" , [ "PROPERTY" ] , "GRAPH" , [ "IF" , "EXISTS" ] ,
                  graph_name , [ ";" ] ;
create_graph_type = "CREATE" , [ "OR" , "REPLACE" ] , [ "PROPERTY" ] , "GRAPH" ,
                    "TYPE" , [ "IF" , "NOT" , "EXISTS" ] , name , [ "AS" ] ,
                    graph_type_source , [ ";" ] ;
drop_graph_type = "DROP" , [ "PROPERTY" ] , "GRAPH" , "TYPE" ,
                  [ "IF" , "EXISTS" ] , name , [ ";" ] ;
(* PROPERTY is a word the statement may carry and neither reading needs:
   every graph zu holds is a property graph. OR REPLACE takes a taken
   name over and IF NOT EXISTS leaves it alone, so a statement saying
   both says nothing and is refused. A schema is a directory, so
   replacing one would take every graph in it along, and OR REPLACE is
   refused there rather than given that meaning. *)
schema_path     = "/" , [ name , { "/" , name } ] ;
(* One slash and nothing after it is the root schema, which every file
   has and which is not one to drop. *)
graph_name      = name | "/" , { name , "/" } , name ;
(* A graph written as a path says which schema it is in and a bare name
   is a graph in the root schema. *)
graph_type_ref  = [ "ANY" , [ "PROPERTY" ] , [ "GRAPH" ]
                  | ( "::" | "TYPED" ) , name
                  | graph_type_source ] ;
(* What the new graph is: the open type, a graph type the file already
   holds, or one written where the graph is created. Nothing written is
   ANY, which is what every zu1 file has held so far. *)
graph_type_source = element_type_list | "LIKE" , name ;
(* A graph type written out in braces is closed: a list nobody qualified
   is the whole list. LIKE reads the tables of the graph named, not the
   data. *)
element_type_list = "{" , [ element_type , { "," , element_type } ] , "}" ;
element_type    = [ ( "NODE" | "EDGE" | "RELATIONSHIP" ) , "TYPE" , name ] ,
                  node_type_pattern , [ arc , node_type_pattern ] ;
(* An element type is the pattern an element of it matches. One pattern
   is a node type; two with an arc between them are an edge type, and
   the name written before the first belongs to the edge. *)
node_type_pattern = "(" , type_body , ")" ;
arc             = "-" , "[" , type_body , "]" , "-" , [ ">" ]
                | "<" , "-" , "[" , type_body , "]" , "-"
                | "~" , "[" , type_body , "]" , "~" ;
(* A tilde arc, or an arc with no arrowhead, is an undirected edge type,
   which is GH02 and a property of the type rather than of the pattern.
   The tilde is the spelling a pattern uses for the same thing and the
   arrowless dash is what this grammar had before it. *)
type_body       = [ name ] , [ ":" , label_set ] ,
                  [ "=>" , ":" , label_set ] , [ property_types ] ;
(* The labels before the arrow are the key label set (GG21) and the ones
   after it are the rest of what the element carries. No arrow declares
   no key, in which case the whole label set stands in for one (GG22).
   A written key label set names between 1 and 63 labels, impdef IL003:
   empty is a type nothing selects and 64 leaves no room in the 64 bit
   mask a label set is for the label the arrow adds, which is where
   42012 to 42015 are raised. A body that is a name and nothing else is
   a reference to an element type declared elsewhere, and a body with a
   label or a property in it declares one where it stands. *)
label_set       = name , { "&" , name } ;
property_types  = "NO" , "PROPERTIES"
                | [ "PROPERTIES" ] , "{" , [ property_type ,
                  { "," , property_type } ] , "}" ;
property_type   = name , ( "::" | "TYPED" ) , value_type ;
(* A property whose type admits null is one an element may leave out,
   so NOT NULL is what makes a property mandatory. One rule about null
   rather than two. *)

reading_clause  = match_clause | for_clause | unwind_clause | filter_clause
                | let_clause | with_clause | call_clause ;

(* GP01, GP02 and GP03, ISO 13.2 and 13.4. The inline procedure call: a
   statement written inside another one. It runs once for each row that
   reaches it, and what its RETURN names is added to that row rather
   than put in place of it, which is what tells it from a WITH.

   The variable scope clause says what the block may read of the row.
   No clause at all is a block that reads all of it (GP02), a list is
   the names the reader wrote (GP03), and an empty list is a block that
   reads nothing, which is a whole statement standing on its own.

   The word is a named call's too, and that reading is the one a name
   after CALL gets. Which of the two a call is is settled by the one
   token after the word: a brace or a parenthesis is the inline call,
   and a name, a path or AT is the named one. *)
call_clause     = "CALL" , ( inline_procedure_call | named_procedure_call ) ;
inline_procedure_call
                = [ variable_scope ] , "{" , [ leading_catalog_part ] ,
                  [ at_schema_clause ] , [ use_clause ] ,
                  { binding_variable_definition } , [ use_clause ] ,
                  composite_query , "}" ;
leading_catalog_part
                = catalog_statement , "NEXT" ,
                  { catalog_statement , "NEXT" } ;
(* GP18 again. A call body is a procedure body, so a catalog statement
   may open one, and where it does the parts are taken out of the body
   and put in front of the statement. That only holds for a call the
   statement begins with, which runs for the one row a statement starts
   from; anywhere else the body runs once for every row that reaches
   it, a thing is made once or not at all, and a catalog statement in
   there is refused rather than hoisted out of the loop it was written
   in. Behind the data statements of a body it is refused too, since
   taking it out would run it before the statements it follows.

   The schema clause travels the same road. A call the statement begins
   with is taken out of the call whole, so the clause its body carries
   becomes the clause of the query the statements land in; a body that
   is spliced into the statement around it resolves names where that
   statement does, so a clause there is refused rather than ignored.

   The graph clause has to travel it, a spliced body running against
   the graph the statement around it does and a body that named one not
   doing that, and its definitions come out with it since the clause
   may read one. What that costs is that the clause governs the whole
   chain the statements land in, zu running one graph per query, so a
   statement written behind such a call may only project what the call
   answered: one that reads the graph was written outside the call and
   against another graph, and it is refused rather than read against
   the graph nobody wrote it for. *)
variable_scope  = "(" , [ name , { "," , name } ] , ")" ;

(* GP04, ISO 13.1. The named procedure call. The name is a catalog
   object reference, so it is read the way a graph's name is: a bare
   name, or a path saying which schema it is in. The AT clause says
   that schema instead, and the two are never both written, since
   whitespace is nothing to the lexer and a path after a path reads as
   one longer path. What a procedure takes and what it yields are the
   procedure's own, so the arguments and the YIELD columns are checked
   against the catalog and not against this grammar.

   An argument is an expression, and two of the things an expression may
   be are not values: a graph reference or a name standing for one says
   which graph the procedure reads (GP15), and a name standing for a
   binding table stands where a list of arguments stands (GP14). Neither
   is a shape of its own here, since both are already expressions, and
   which procedure takes which is the catalog's to say. *)
named_procedure_call
                = [ "AT" , schema_path ] , procedure_ref , "(" ,
                  [ expression , { "," , expression } ] , ")" ,
                  yield_clause ;
procedure_ref   = name | "/" , { name , "/" } , name ;

match_clause    = ( "MATCH" , pattern , [ where_clause ]
                  | "OPTIONAL" , ( "MATCH" , pattern , [ where_clause ]
                                 | match_block ) ) , [ yield_clause ] ;
(* GQ19, ISO 16.14. Which of the names a match wrote leave it, and what
   they are called after it. An item is a variable rather than an
   expression, since a yield says what leaves the match and not what to
   compute out of it. The word is a table function's too, and that
   reading is the one a CALL gets. *)
yield_clause    = "YIELD" , yield_item , { "," , yield_item } ;
yield_item      = name , [ "AS" , name ] ;
(* GQ21 and GQ22, ISO 14.4 and 19.4. A block of match statements is one
   conjunction: its statements are all required and they share the names
   they write, so an OPTIONAL over a block keeps what the whole block
   answered or nulls every name in it, and an EXISTS over one asks
   whether it answered a row at all. *)
match_block     = "{" , match_statements , "}" ;
match_statements = [ "MATCH" ] , pattern , [ where_clause ] ,
                  { "MATCH" , pattern , [ where_clause ] } ;
(* GQ10, GQ11 and GQ24, ISO 14.8. One row per element of a list, with
   an optional counter over the elements: ORDINALITY counts from one
   and OFFSET from zero. The WITH here is read two tokens at a time,
   since WITH is also a clause and the word after it is what says
   which of the two was written. *)
for_clause      = "FOR" , name , "IN" , expression ,
                  [ "WITH" , ( "ORDINALITY" | "OFFSET" ) , name ] ;

(* The Cypher spelling of the same statement, which names the value
   after the list rather than before it and carries no counter. *)
unwind_clause   = "UNWIND" , expression , "AS" , name ;

(* GQ08, ISO 14.6. The condition on its own, over whatever the
   statement has in hand rather than over a pattern the same clause
   wrote. The WHERE is the standard's own optional word and says
   nothing the FILTER has not already said. *)
filter_clause   = "FILTER" , [ "WHERE" ] , expression ;

(* GQ09, ISO 14.7. Names for values, added to the names already in
   hand: a projection says what the rows are from there on and this
   says what else they carry. The definitions read left to right, so a
   later one may use a name an earlier one gave, and the name is a
   variable rather than anything a projection item may be. *)
let_clause      = "LET" , let_item , { "," , let_item } ;
let_item        = name , "=" , expression ;

with_clause     = "WITH" , projection , [ where_clause ] ;
return_clause   = "RETURN" , projection ;
where_clause    = "WHERE" , expression ;

projection      = [ "DISTINCT" ] , ( "*" | projection_item ) ,
                  { "," , projection_item } ,
                  [ group_by ] , [ order_by ] , [ page ] ;

(* GQ15, ISO 16.15. The grouping the projection would have implied,
   written out: the items say what a row of a group holds and this
   says what a group is, so an item that is not an aggregate has to be
   one of these keys. *)
group_by        = "GROUP" , "BY" , expression , { "," , expression } ;

(* GQ12 and GQ13, ISO 14.9. OFFSET is the standard's word and SKIP is
   the synonym it names for it, so the two are one clause and only one
   of them may be written. *)
page            = [ ( "OFFSET" | "SKIP" ) , expression ] ,
                  [ "LIMIT" , expression ] ;
projection_item = expression , [ "AS" , name ] ;
order_by        = "ORDER" , "BY" , sort_item , { "," , sort_item } ;
sort_item       = expression , [ "ASC" | "ASCENDING" | "DESC" | "DESCENDING" ] ,
                  [ null_ordering ] ;
(* ISO 16.17. A key that names neither one sorts its nulls last, in
   both directions, which is impdef IS001. *)
null_ordering   = "NULLS" , ( "FIRST" | "LAST" ) ;

(* Patterns. *)

pattern         = [ match_mode ] , path , { "," , path } , [ keep_clause ] ;
match_mode      = "REPEATABLE" , ( "ELEMENT" | "ELEMENTS" ) , [ binding_s ]
                | "DIFFERENT" , ( "EDGE" | "EDGES" ) , [ binding_s ] ;
binding_s       = "BINDING" | "BINDINGS" ;
(* ISO 16.9, features G002 and G003. A match mode speaks about the whole
   list where a path mode speaks about one path of it. DIFFERENT EDGES is
   what a list that names none means, and it says two things at once: a
   pattern that named no path mode walks a TRAIL, and no one edge answers
   two of the edge patterns of the list. REPEATABLE ELEMENTS lifts both.
   The singular noun and the BINDINGS behind it are spellings of the same
   mode and say nothing more. The mode belongs to the list rather than to
   the match statement block, so two patterns of one statement may not
   take the same edge where two patterns of two statements of a block
   may. *)
keep_clause     = "KEEP" , path_prefix ;
(* ISO 16.9, features G006 and G007. A KEEP says a prefix once for the
   whole list rather than once in front of each pattern of it, and what
   it does is fill in what the patterns left out: a pattern that named no
   selector takes the KEEP's, one that named no mode takes its mode, and
   one that named the same kind the KEEP names is refused rather than
   settled by a rule of precedence. *)
path            = [ name , "=" ] , [ path_prefix ] , path_body ;
path_body       = factor , { ( ( relationship | simplified ) , factor )
                            | factor } ;
factor          = node | subpath , [ quantifier ] ;
subpath         = "(" , [ name , "=" ] , [ path_mode ] , path_body ,
                  [ where_clause ] , ")" ;
(* ISO 16.11, feature G038. Brackets around part of a pattern match
   nothing of their own: what they do is let three things be said about a
   stretch of a walk rather than about the whole of it, a name for the
   stretch, a path mode for it, and a condition that has to hold of it.
   The condition may read a variable bound outside the brackets, which is
   the non local predicate.

   A factor written straight against another with no edge pattern between
   them is juxtaposition, and the node the left one ends at is the node
   the right one starts at rather than a second node beside it, so the
   two node patterns there describe one node and two names written there
   are two names for one element. A path selector is not on the list of
   what the brackets may carry: how many paths to keep is a question
   about the whole pattern, so the standard writes it in front of one.

   A quantifier behind the brackets repeats the stretch they hold (ISO
   16.11, feature G035). A fixed count is a longer pattern of the same
   shape, which is what the parser writes it out as; a range, and the
   question mark that stands for nought or one, is a pattern per length
   rather than one pattern, and the lengths are written out and run over
   the fork seam the bar between two paths runs on. A count with no
   ceiling on it is refused, there being no writing out a list with no
   end to it. Every repetition binds the
   names inside the brackets again, so such a name stands for one element
   per repetition rather than for one element, which is the group
   variable of feature GQ17: reading it answers the list, reading a
   property of it answers the list of the properties, and an aggregate
   around it folds that row's group rather than the rows, which is the
   horizontal aggregate of feature GE09. *)
path_prefix     = "ALL" , [ "SHORTEST" ] , path_tail
                | "ANY" , ( "SHORTEST" | [ integer ] ) , path_tail
                | "SHORTEST" , ( integer , path_tail , [ group_or_groups ]
                               | [ integer ] , path_tail , group_or_groups )
                | path_mode , [ path_or_paths ] ;
path_tail       = [ path_mode ] , [ path_or_paths ] ;
path_or_paths   = "PATH" | "PATHS" ;
group_or_groups = "GROUP" | "GROUPS" ;
(* The seven path selectors of ISO 16.6, and the mode that sits inside
   the prefix with them rather than behind it: the words come in one
   order, the selector, then the mode, then PATH or PATHS, then GROUP
   last of all. ALL keeps every path a pattern matches, which is what a
   pattern with no selector keeps. ANY keeps one per pair of endpoints
   and ANY k keeps k, whichever ones the search comes to. The four
   shortest forms go by length: ANY SHORTEST keeps one of the least
   length, ALL SHORTEST keeps every path of it, SHORTEST k keeps k paths
   counted shortest first, and SHORTEST k GROUP keeps every path whose
   length is one of the k least. PATH and PATHS say nothing the rest of
   the prefix has not, while GROUP is the whole of the difference between
   counting paths and counting lengths, and a group count left out is one
   group. A count of zero is refused: it keeps no path whatever the graph
   holds. *)
path_mode       = "WALK" | "TRAIL" | "SIMPLE" | "ACYCLIC" ;
(* The four differ only in the repeat they forbid: none, a repeated
   edge, a repeated node except the one the path started at, and a
   repeated node anywhere. SIMPLE and ACYCLIC are not substitutes for
   one another, because a cycle is a simple path and not an acyclic
   one. *)
node            = "(" , [ name ] , { ":" , label_expr } ,
                  [ property_map ] , [ "WHERE" , expression ] , ")" ;
(* The condition inside the parentheses is the element pattern
   predicate of ISO 16.6, feature G041. It is asked of the one element
   the pattern is standing on, where the pattern reaches it, and it may
   read what the pattern bound to its left, which is what "non local"
   names. *)
label_expr      = label_term , { "|" , label_term } ;
label_term      = label_factor , { "&" , label_factor } ;
label_factor    = { "!" } , label_atom ;
label_atom      = name | "%" | "(" , label_expr , ")" ;
(* A repeated colon is a conjunction, so `(n:A:B)` and `(n:A&B)` are
   the same pattern, and `%` holds of every element because an element
   always carries the label of the table it lives in. *)

relationship    = ( [ "<" ] , bar , [ rel_detail ] , bar , [ ">" ]
                  | [ "<" ] , bar , [ ">" ] ) , [ quantifier ] ;
bar             = "-" | "~" ;
(* The seven edge patterns of ISO 18.9, written as one production with
   two rules the parser applies: both bars are the same character, and
   a tilde takes no arrowhead. That leaves `-[]->`, `<-[]-`, `<-[]->`,
   `~[]~`, `<~[]~`, `~[]~>` and `-[]-`. The second alternative is the
   abbreviated form of each, which drops the bracket and the second bar
   with it, so `->` is `-[]->` and `~` is `~[]~`. A dash says the edge
   has a direction and the arrowheads say which way the pattern walks
   it; a tilde says the edge has none, which is GH02 and a property of
   the edge type rather than of the pattern. `-[]-` walks either kind
   either way round. *)
rel_detail      = "[" , [ name ] , [ ":" , name , { "|" , name } ] ,
                  [ "*" , [ hop_range ] ] , [ property_map ] ,
                  [ "WHERE" , expression ] , "]" ;
(* The same predicate on an edge, asked of every edge the step walks
   before the step walks it, so an edge that fails it is never followed
   and no longer path is built through it. *)
hop_range       = integer , [ ".." , [ integer ] ]
                | ".." , integer ;
(* `*n` alone means exactly n hops; a bare `*` is unbounded. *)
quantifier      = "+" | "*" | "{" , [ integer ] , [ "," , [ integer ] ] , "}" ;
(* The standard's way of writing the same repetition, behind the arrow
   rather than inside the brackets: `+` is one or more, `*` is zero or
   more, `{n}` is exactly n, and `{n,m}` is a range with either end
   allowed to be left out. A step carries one of the two forms and not
   both. A step of no hops is not walked yet, so `*` and a lower bound
   of 0 are refused rather than read as `+`. *)

simplified      = [ "<" ] , bar , "/" , simple_contents , "/" , bar ,
                  [ ">" ] ;
simple_contents = simple_term , { "|" , simple_term } ;
simple_term     = simple_factor , { simple_factor } ;
simple_factor   = [ "<" | "~" ] , simple_primary , [ ">" ] ,
                  [ "?" | quantifier ] ;
simple_primary  = name | "(" , simple_contents , ")" ;
(* ISO 16.12, features G039 and G080 to G082. A stretch of edges
   written between one pair of slashes, with the nodes between them
   left unwritten: `-/ A B /->` is `-[:A]->()-[:B]->`, and the parser
   reads it as that pattern, so nothing below the parser knows the
   short form was written. The arrow around the slashes is the same
   seven directions an ordinary arrow writes and it defaults every
   step of the stretch; a step overrides it by writing `<` in front of
   its label or `>` behind it, which is what features G081 and G082
   are. Inside the slashes a label is a step, two written against each
   other are two steps, a bar is either label on the one step, and a
   quantifier repeats what stands in front of it: a count with a floor
   of one or more over a single step is the hop range the arrow
   already writes, and every other count is written out the way a
   quantifier behind brackets is. What the standard writes here for
   label expressions this engine has no store for is refused by name:
   an edge is kept under exactly one type, so `!`, `%` and `&` have no
   reading, and a bar separating stretches of more than one step is an
   alternation of paths rather than of labels, which the bar between
   whole patterns already says. *)

property_map    = "{" , [ name , ":" , expression ,
                  { "," , name , ":" , expression } ] , "}" ;

(* Expressions, loosest binding first. Nesting is capped at 64. *)

expression      = xor_expr , { "OR" , xor_expr } ;
xor_expr        = and_expr , { "XOR" , and_expr } ;
and_expr        = not_expr , { "AND" , not_expr } ;
not_expr        = { "NOT" } , comparison ;
comparison      = concat , { comparison_op , concat
                             | "IS" , [ "NOT" ] , "NULL"
                             | "IS" , [ "NOT" ] , "TYPED" , value_type
                             | "IS" , [ "NOT" ] , "DIRECTED"
                             | "IS" , [ "NOT" ] , "LABELED" , label_expr
                             | "IS" , [ "NOT" ] , "NORMALIZED" ,
                               [ normal_form ]
                             | "IS" , [ "NOT" ] ,
                               ( "SOURCE" | "DESTINATION" ) , "OF" ,
                               concat } ;
(* ISO 19.8 to 19.10, features G110, G111 and G112. The three pattern
   predicates written after IS: whether an edge has a direction,
   whether an element carries a label, and whether a node is one end of
   an edge. The word behind IS is what tells all six readings apart,
   NULL and TYPED included. *)
(* ISO 19.7 and 20.24, mandatory. The predicate and the function ask
   the same question of a string, whether it is already in a Unicode
   normal form and what it looks like in one. The form is a word rather
   than an expression, so which normalization runs is settled by the
   statement and not by a row, and it defaults to NFC in both places,
   which is what the standard defaults it to. *)
normal_form     = "NFC" | "NFD" | "NFKC" | "NFKD" ;
normalize       = "NORMALIZE" , "(" , expression ,
                  [ "," , normal_form ] , ")" ;
(* ISO 20.27, mandatory. The temporal value functions, which come in
   pairs: a word that asks the time and a word that reads the same type
   out of a string. The first four are written bare, the grammar giving
   them no parentheses, so CURRENT_DATE() is a call to a function nobody
   defined, and LOCAL_TIME is the one the standard writes both ways. The
   bracketed five must be bracketed, and their brackets may stand empty,
   which reads the clock and answers what the word beside them answers.
   Every clock reading in a statement is cut from one instant, read once
   before the first row, so a statement holding two of them cannot have
   them land on two different days.

   ISO writes each parameter as a string or a record constructor. zu
   reads the string and not yet the record. *)
clock_fn        = "CURRENT_DATE" | "CURRENT_TIME" | "CURRENT_TIMESTAMP"
                | "LOCAL_TIMESTAMP" ;
temporal_word   = "DATE" | "ZONED_TIME" | "LOCAL_TIME"
                | "ZONED_DATETIME" | "LOCAL_DATETIME" ;
temporal_fn     = clock_fn | "LOCAL_TIME"
                | temporal_word , "(" , [ expression ] , ")" ;
(* ISO 20.29, mandatory. The duration functions. DURATION reads a length
   of time out of a string and has no empty form, there being a date now
   and a time now and no length of time now, and ABS answers the length
   of a duration without its sign, which is the same word the numbers
   are given. *)
duration_fn     = "DURATION" , "(" , expression , ")"
                | "ABS" , "(" , expression , ")" ;
(* ISO 20.28, mandatory. The length of time from the first datetime to
   the second, which is the minus between them written the other way
   round. The qualifier stands behind the closing bracket, where no
   call has anything, and says which of the two duration kinds the
   answer is; leaving it out reads as DAY TO SECOND. Only those two
   runs of fields are a temporal duration qualifier, which is narrower
   than the interval qualifier behind an interval string. The two
   arguments have to be the same shape, since a date and a time have no
   length between them and neither has a local datetime and a zoned
   one. *)
duration_qual   = "YEAR" , "TO" , "MONTH" | "DAY" , "TO" , "SECOND" ;
duration_between = "DURATION_BETWEEN" , "(" , expression , "," ,
                  expression , ")" , [ duration_qual ] ;
(* ISO 12 and feature GA04. Two values of different types compare
   rather than answer unknown, and the order between the types is
   booleans, numbers, strings, temporals, nodes, edges, lists, records,
   paths, which is impdef IV010. It is the order ORDER BY uses, so a
   predicate and a sort key never disagree about which value is first. *)
comparison_op   = "=" | "<>" | "<" | "<=" | ">" | ">=" | "IN"
                | "STARTS" , "WITH" | "ENDS" , "WITH" | "CONTAINS" ;
(* ISO 20.23, mandatory. Concatenation binds tighter
   than a comparison and looser than an addition, which is where the
   standard puts it: 'a' || b = c asks about the joined string, and
   'n=' || 1 + 2 joins the sum rather than joining the one and adding
   the two. Both sides are strings and nothing else, since a plus over
   two numbers adds them and a plus over two strings would have to
   guess, and a query that meant the digits of a number says so with a
   CAST. A null on either side gives null. *)
concat          = additive , { "||" , additive } ;
additive        = multiplicative , { ( "+" | "-" ) , multiplicative } ;
multiplicative  = unary , { ( "*" | "/" | "%" ) , unary } ;
unary           = { "-" | "+" } , postfix ;
postfix         = primary , { "." , name } ;
primary         = literal | temporal_literal | parameter | name
                | function_call | cast | property_exists | normalize
                | temporal_fn | duration_fn | duration_between
                | case_expr | coalesce | nullif
                | path_constructor | exists_block
                | value_query | "(" , expression , ")" | list | record ;

cast            = "CAST" , "(" , expression , "AS" , value_type , ")" ;
(* ISO 20.7 and mandatory feature GE01. Two forms: the searched one
   asks a condition per branch, and the simple one names a value and
   compares each branch with it. Whether a value stands before the
   first WHEN is what tells them apart. The branches are asked in the
   order they were written and only the branch that holds is
   evaluated, so a CASE may guard an expression the other rows cannot
   answer. A CASE that holds no branch and wrote no ELSE is null.
   CASE is the one word of the expression grammar with nothing behind
   it to tell it from a variable read, so it is a word wherever an
   expression begins. *)
case_expr       = "CASE" , [ expression ] , when_branch , { when_branch } ,
                  [ "ELSE" , expression ] , "END" ;
when_branch     = "WHEN" , expression , "THEN" , expression ;
(* The case abbreviations of the same clause, written like calls and
   read like forms: COALESCE stops at the first argument that is not
   null, so what a function would have evaluated before it was entered
   is what these two decide not to evaluate at all. *)
coalesce        = "COALESCE" , "(" , expression , { "," , expression } , ")" ;
nullif          = "NULLIF" , "(" , expression , "," , expression , ")" ;
(* ISO 19.13 and feature G115. Written like a call and not one: the
   second argument is a property name rather than an expression, so
   reading it as one would bind a variable the query never wrote.
   ALL_DIFFERENT and SAME (G113, G114) are ordinary calls, since their
   arguments are the elements themselves. *)
property_exists = "PROPERTY_EXISTS" , "(" , expression , "," , name , ")" ;
(* ISO 19.4. An existence predicate asks whether something matched, and
   the standard writes three things after the word: a graph pattern, a
   block of match statements, and a whole query. Braces hold any of the
   three and parentheses hold the first two, a query in parentheses not
   being a shape the standard offers. The RETURN is what tells a query
   from a block, since a block answers the names its patterns wrote and
   a query answers the columns it returns. What the query returns is
   never read, only whether it returned a row, so a query answering no
   row is false where a value query would have been null. The bracket
   is what tells the whole thing apart from a variable called exists. *)
exists_block    = "EXISTS" , ( "{" , ( match_statements
                                     | composite_query ) , "}"
                             | "(" , match_statements , ")" ) ;
(* GQ18, ISO 20.6. A whole query written where one value belongs. It is
   a query and not a block: it may chain with NEXT, join with a set
   operator and end with an ORDER BY and a LIMIT, and it has to end with
   a RETURN of one column, because one value is what stands here. The
   brace tells it apart from a variable called value, the same way it
   does for EXISTS. *)
value_query     = "VALUE" , "{" , composite_query , "}" ;
(* A value type is a name, its arguments, and whether it admits null.
   The names are the ISO spellings and live in one table; see
   crates/zu-query/src/value_type.rs. *)
value_type      = type_component , { "|" , type_component } ,
                  [ "NOT" , "NULL" ] ;
type_component  = "ANY" , [ "VALUE" | "RECORD" | "GRAPH"
                          | "PROPERTY" , "VALUE" ]
                | "RECORD" , [ record_fields ]
                | list_type
                | type_name , [ "(" , integer , { "," , integer } , ")" ] ,
                  [ list_name , [ "(" , integer , ")" ] ] ;
(* A list type either names the element type inside angle brackets or
   follows it, and a list type with neither admits a list of anything.
   The count in parentheses is the maximum length. *)
list_type       = list_name , [ "<" , value_type , ">" ] ,
                  [ "(" , integer , ")" ] ;
list_name       = [ "GROUP" ] , ( "LIST" | "ARRAY" ) ;
record_fields   = "{" , [ name , "::" , value_type ,
                  { "," , name , "::" , value_type } ] , "}" ;

(* ISO 20.22 and 20.24, mandatory. Five
   questions about a string, all written as ordinary calls of one
   argument. CHAR_LENGTH and CHARACTER_LENGTH are two spellings of the
   same function and count characters, OCTET_LENGTH counts the bytes
   the store keeps, and the two agree only for ASCII. UPPER and LOWER
   fold, and the one argument TRIM takes the spaces off both ends. A
   number here is refused rather than measured by its spelling. *)
(* The set quantifier of ISO 20.9 belongs to the set functions and is
   read here so one place parses a call. ALL is what leaving it out
   means, so `COUNT(ALL n)` and `COUNT(n)` are one plan. *)
function_call   = name , "(" , [ "DISTINCT" | "ALL" ] ,
                  [ "*" | expression , { "," , expression } ] , ")" ;
list            = "[" , [ expression , { "," , expression } ] , "]" ;
(* The same braces are an inline property predicate inside a pattern
   and a record constructor in an expression. A field name written
   twice is refused rather than resolved. *)
record          = property_map ;
(* GE06. PATH is a name until a bracket follows it, the same way DATE is
   a name until a string does. The elements alternate node and edge with
   a node at each end, and each edge has to join the two nodes it sits
   between, which is 22G0Z and a question only the graph answers. *)
path_constructor = "PATH" , "[" , [ expression , { "," , expression } ] , "]" ;

literal         = "NULL" | "TRUE" | "FALSE" | integer | float | string ;
(* A temporal literal is a type name and the value written as a string,
   so DATE '2024-01-15' and DURATION 'P2D'. The name is read as a type
   only when a string follows it, which leaves DATE usable as a name. *)
temporal_literal = temporal_name , string | interval_literal ;
temporal_name   = "DATE" | "TIME" | "DATETIME" | "TIMESTAMP" | "DURATION"
                | ( "LOCAL" | "ZONED" ) ,
                  ( "TIME" | "DATETIME" | "TIMESTAMP" ) ;
(* The SQL spelling of a duration, where the qualifier is required
   because it is what says how to read the string: '1-2' is a year and
   two months under YEAR TO MONTH and is no duration at all under DAY.
   The ISO 8601 spelling keeps its own word, DURATION, so there is one
   spelling for each and INTERVAL 'P1D' is neither. A precision bounds
   the digits that were written and nothing else. *)
interval_literal = "INTERVAL" , [ "+" | "-" ] , string , interval_qualifier ;
interval_qualifier = interval_field , [ precision ] ,
                  [ "TO" , interval_field , [ precision ] ] ;
interval_field  = "YEAR" | "MONTH" | "DAY" | "HOUR" | "MINUTE" | "SECOND" ;
precision       = "(" , integer , [ "," , integer ] , ")" ;
(* Every ISO spelling of a type: the integer tower and its word
   spellings, the decimals, the floats, BOOL, the string and byte string
   names, the temporal names above, PATH, BINDING TABLE, NULL and
   NOTHING. *)
type_name       = identifier , [ identifier ] ;

(* Lexical shapes. *)

(* A delimited name is quoted the way a string is, down to the doubling
   and the escapes, so `odd``name` is one name with an accent in it. *)
name            = identifier | [ "@" ] , "`" , { character } , "`" ;
identifier      = ( letter | "_" ) , { letter | digit | "_" } ;
(* One dollar sign is a general parameter and two is a substituted
   one, which is how the standard writes a parameter holding a
   reference. Both name the same parameter here, because the value
   that arrives says which it is. *)
parameter       = ( "$" | "$$" ) , ( letter | digit | "_" ) ,
                  { letter | digit | "_" } ;
(* A number may be written in another radix, and it may say which kind
   of number it means: M for an exact one, F and D for an approximate
   one. An exact number with no fraction is an integer; zu has no
   decimal type, so an exact fraction is widened to a double. The digits
   of a long number may be grouped with an underscore, which stands
   between two digits and, in a radix other than ten, in front of the
   first one as well. *)
integer         = digits , [ "M" ]
                | ( "0x" | "0o" | "0b" ) , radix_digits ;
digits          = digit , { [ "_" ] , digit } ;
radix_digits    = { [ "_" ] , radix_digit } - "" ;
float           = digits , "." , digits , [ exponent ] , [ suffix ]
                | digits , exponent , [ suffix ]
                | digits , ( "F" | "D" ) ;
suffix          = "M" | "F" | "D" ;
exponent        = ( "e" | "E" ) , [ "+" | "-" ] , digits ;
radix_digit     = digit | "a" | "b" | "c" | "d" | "e" | "f" ;
string          = [ "@" ] , "'" , { character } , "'"
                | [ "@" ] , '"' , { character } , '"' ;
(* String escapes: \\ \' \" \` \n \r \t \b \f, and \uXXXX and
   \UXXXXXX for a character named by its code point. An @ before the
   quote turns escape processing off, and a doubled quote is then the
   only way to write one. Comments run to the end of the line after //
   or after --, or from /* to */; all three are whitespace to the
   parser, which costs the Cypher spellings (a)--(b) and (a)-->(b),
   since GQL writes those (a)-(b) and (a)->(b) and reads a double minus
   as a comment wherever it stands. *)

(* Reserved but not yet parsed; the parser rejects them by name:
   CREATE, SESSION. CREATE is a statement only where GRAPH follows it,
   with OR REPLACE and PROPERTY allowed in between; anywhere else it is
   still the write nobody has implemented. The rest of the write words,
   INSERT, SET, REMOVE, DELETE, DETACH DELETE and MERGE, are parsed. *)
